      "name": "Auth - Registrar usuario de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('testUsername', 'qa_' + Date.now());",
              "pm.collectionVariables.set('testEmail', pm.collectionVariables.get('testUsername') + '@qa.jcee.test');",
              "pm.collectionVariables.set('testUsername2', pm.collectionVariables.get('testUsername') + '_b');",
              "pm.collectionVariables.set('testEmail2', pm.collectionVariables.get('testUsername') + '_b@qa.jcee.test');"
