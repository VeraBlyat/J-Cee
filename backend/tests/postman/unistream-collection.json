    {
      "name": "Comments - Cambiar el voto a dislike",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = pm.response.json();",
              "pm.test('el like se convierte en dislike, no se suma otro voto', () => {",
