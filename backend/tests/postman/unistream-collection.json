          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('devuelve el usuario creado', () => {",
              "  pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
