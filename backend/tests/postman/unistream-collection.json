              "  pm.expect(hilo[0].replies[0].id).to.eql(Number(pm.collectionVariables.get('testReplyId')));",
              "});",
              "pm.test('trae los contadores de votos', () => {",
              "  pm.expect(hilo[0].likes).to.eql(0);",
              "  pm.expect(hilo[0].dislikes).to.eql(0);",
