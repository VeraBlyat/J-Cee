    {
      "name": "HLS - Master playlist lista las calidades",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const txt = pm.response.text();",
              "pm.test('es una playlist HLS', () => pm.expect(txt).to.include('#EXTM3U'));",
              "// La fuente es 240p, así que sólo debe ofrecer 240p (nunca escalar hacia arriba).",
              "pm.test('no escala hacia arriba', () => {",
              "  pm.expect(txt).to.not.include('720p/index.m3u8');",
              "  pm.expect(txt).to.include('index.m3u8');",
              "});",
              "const calidad = /([0-9]+p)\\/index\\.m3u8/.exec(txt)[1];",
              "pm.collectionVariables.set('testQuality', calidad);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/videos/{{testVideoId}}/hls/master.m3u8",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "videos",
            "{{testVideoId}}",
            "hls",
            "master.m3u8"
          ]
        }
      }
    },
    {
      "name": "HLS - Media playlist declara fMP4 y VOD",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const txt = pm.response.text();",
              "pm.test('es VOD y cierra con ENDLIST', () => {",
              "  pm.expect(txt).to.include('#EXT-X-PLAYLIST-TYPE:VOD');",
              "  pm.expect(txt).to.include('#EXT-X-ENDLIST');",
              "});",
              "pm.test('declara el segmento de init (fMP4)', () => {",
              "  pm.expect(txt).to.include('#EXT-X-MAP:URI=\"init.mp4\"');",
              "  pm.expect(txt).to.include('#EXT-X-VERSION:7');",
              "});",
              "pm.test('lista segmentos .m4s', () => pm.expect(txt).to.match(/^0\\.m4s$/m));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
