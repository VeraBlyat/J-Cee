    {
      "name": "Videos - Detalle trae metadata y hashtags normalizados",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const v = pm.response.json();",
              "pm.test('ffprobe guardó duración y resolución', () => {",
              "  pm.expect(v.duration_seconds).to.be.above(0);",
              "  pm.expect(v.width).to.eql(320);",
              "  pm.expect(v.height).to.eql(240);",
              "});",
              "pm.test('se generó la miniatura', () => pm.expect(v.thumbnail_path).to.be.a('string'));",
              "pm.test('hashtags en minúscula y sin duplicados', () => {",
              "  pm.expect(v.hashtags).to.eql(['automatizado', 'qa']);",
              "});"
            ]
          }
