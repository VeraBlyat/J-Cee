# Copia este archivo como ".env" y pon TUS datos de PostgreSQL.
# DATABASE_URL debe apuntar a la MISMA base de datos que usa el frontend.
DATABASE_URL=postgresql://unistream:Ifuckthemusic1@unistreamdb.postgres.database.azure.com:5432/unistream
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# En local no hace falta. En producción contra Azure Database for
# PostgreSQL (u otro proveedor que exija SSL), poné DATABASE_SSL=true.
DATABASE_SSL=false

# Recuperación de contraseña. Mientras no haya servidor de correo, el enlace de
# reseteo no se puede enviar por mail. En dev igual se devuelve en la respuesta
# para poder probarlo; en producción NO, salvo que prendas esto explícitamente.
# Poné EXPOSE_RESET_LINK=true SÓLO en un despliegue sin SMTP donde asumís que el
# enlace viaja en la respuesta HTTP. Apenas haya envío por correo, borrá o dejá
# esto en false.
EXPOSE_RESET_LINK=false
