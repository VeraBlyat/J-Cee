# =====================================================================
#  Variables de la COMPUTADORA DEL BACKEND (PC-BACK, 192.168.13.10)
#  Copia este archivo como ".env" en esta misma carpeta:
#      cp .env.example .env
#  y edita la contraseña. El archivo .env NO se sube a git.
# =====================================================================

# --- Base de datos --------------------------------------------------------
POSTGRES_USER=unistream
POSTGRES_DB=unistream
# CÁMBIALA. Es la contraseña de PostgreSQL dentro de la red de Docker.
POSTGRES_PASSWORD=cambia_esta_password

# --- Dominio de la API ----------------------------------------------------
# Tiene que coincidir con el CN/SAN del certificado api.crt y con lo que
# resuelve el DNS (dnsmasq/dnsmasq.conf).
API_DOMAIN=api.unistream.lan

# --- CORS -----------------------------------------------------------------
# Origen(es) del frontend que pueden llamar a la API con cookies.
# Acepta varios separados por coma (útil mientras pruebas por IP).
FRONTEND_ORIGIN=https://unistream.lan,https://192.168.13.20
