# =====================================================================
#  Variables de la COMPUTADORA DEL FRONTEND (PC-FRONT, 192.168.13.20)
#  Copia este archivo como ".env" en esta misma carpeta:
#      cp .env.example .env
# =====================================================================

# Dominio con el que se entra al sitio (tiene que coincidir con web.crt).
WEB_DOMAIN=unistream.lan

# Dominio de la API que corre en la otra computadora (coincide con api.crt).
API_DOMAIN=api.unistream.lan

# IP de la computadora del backend en la LAN. Se inyecta como /etc/hosts
# dentro de los contenedores (extra_hosts), para no depender del DNS.
BACKEND_IP=192.168.13.10
